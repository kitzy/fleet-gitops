<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadDescription</key>
	<string>DDM conversion demo — installs a throwaway self-signed root CA (Kitzy DDM Demo Root CA, not used for anything real). Maps cleanly to Apple's own canonical DDM certificate pattern: the com.apple.asset.credential.certificate asset declaration carries the certificate data by reference (URL + hash) instead of embedding it, and the com.apple.configuration.security.certificate declaration just points at that asset via CredentialAssetReference.</string>
	<key>PayloadDisplayName</key>
	<string>DDM Demo: Root Certificate</string>
	<key>PayloadIdentifier</key>
	<string>net.kitzy.mdm.ddm-demo.root-certificate</string>
	<key>PayloadOrganization</key>
	<string>Kitzy.net</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>C8224DF0-165E-4B5B-90A5-41A524E0C783</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
